# ─────────────────────────────────────────────────────────────────────────────
# gami-vaults-tracker-bot — copy to .env (local) or into the Render env vars
# Only BOT_TOKEN and CHAT_ID are required.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Telegram (required) ─────────────────────────────────────────────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_ID=-1001234567890

# ─── Telegram commands (/vaults, /help, /addvault) ───────────────────────────
# Telegram user IDs allowed to use /addvault (comma-separated).
# To find yours: send /addvault to the bot, it replies with it.
ADMIN_USER_IDS=123456789
# Fine-grained GitHub token: Repository access = this repository only,
# Permissions → Actions: Read and write. Without it, /addvault is disabled.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# Target repository: detected automatically on Render (RENDER_GIT_REPO_SLUG)
# GITHUB_REPO=marien-gami/gami-vaults-tracker-bot
# TELEGRAM_COMMANDS=off   # disables receiving commands entirely

# ─── Scan frequency ──────────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# ─── RPC (optional) ──────────────────────────────────────────────────────────
# Every chain already has default public RPCs (see chains.js), tested with
# eth_getLogs over 2000 blocks. Only add RPC_URL_<chainId> to put a private/paid
# RPC IN FRONT of these defaults. Several URLs allowed, comma-separated:
# on failure (429, 403, timeout…) the bot moves on to the next one.
#
# RPC_URL_1=https://my-private-rpc.example/KEY,https://ethereum-rpc.publicnode.com
# RPC_URL_8453=
# RPC_URL_43114=
# RPC_URL_43111=
# RPC_URL_14=
# RPC_URL_4663=
#
# ⚠️ An RPC limited to small ranges (e.g. Alchemy free tier = 10 blocks)
# requires lowering that chain's range: LOGS_BLOCK_RANGE_<chainId>=10
# The old ALCHEMY_*_RPC_URL variables are no longer read.

# ─── Pointer persistence (recommended in production) ─────────────────────────
# Without a persistent disk, every redeploy restarts from the chain head and
# events that happen during the restart are not alerted.
# On Render: add a Persistent Disk mounted at /var/data, then:
# POINTERS_FILE=/var/data/.pointers.json

# ─── Advanced settings (defaults shown) ──────────────────────────────────────
# LOGS_BLOCK_RANGE=            # forces the eth_getLogs range for all chains
# LOGS_BLOCK_RANGE_<chainId>=  # range for one chain (default: chains.js, 2000)
# LOGS_MAX_ADDRESSES=10        # max addresses per eth_getLogs call (publicnode limit)
# RPC_MAX_RETRIES=2            # retry rounds across all URLs
# MAX_CHUNKS_PER_TICK=20       # max ranges per tick and per chain (bounds catch-ups)
# MAX_CHUNKS_PER_TICK_<chainId>=
# MAX_CATCHUP_BLOCKS=100000    # at boot, never go further back than this
# LAG_ALERT_BLOCKS=20000       # Telegram alert if lag > N blocks (0 = off)
