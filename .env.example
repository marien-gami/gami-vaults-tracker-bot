# ─────────────────────────────────────────────────────────────────────────────
# gami-vaults-tracker-bot — copier en .env (local) ou dans les variables Render
# Seules BOT_TOKEN et CHAT_ID sont obligatoires.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Telegram (obligatoire) ──────────────────────────────────────────────────
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CHAT_ID=-1001234567890

# ─── Commandes Telegram (/vaults, /help, /addvault) ──────────────────────────
# User IDs Telegram autorisés à /addvault (séparés par des virgules).
# Pour connaître le tien : envoie /addvault au bot, il te le répond.
ADMIN_USER_IDS=123456789
# Token GitHub fine-grained : Repository access = ce dépôt uniquement,
# Permissions → Actions : Read and write. Sans lui, /addvault est désactivé.
GITHUB_TOKEN=github_pat_xxxxxxxxxxxxxxxxxxxx
# Dépôt cible : déduit automatiquement sur Render (RENDER_GIT_REPO_SLUG)
# GITHUB_REPO=marien-gami/gami-vaults-tracker-bot
# TELEGRAM_COMMANDS=off   # désactive complètement la réception des commandes

# ─── Fréquence de scan ───────────────────────────────────────────────────────
CHECK_INTERVAL_SECONDS=60

# ─── RPC (optionnel) ─────────────────────────────────────────────────────────
# Chaque chain a déjà des RPC publics par défaut (voir chains.js), testés sur
# eth_getLogs 2000 blocs. N'ajouter RPC_URL_<chainId> que pour mettre un RPC
# privé/payant DEVANT ces défauts. Plusieurs URLs possibles, séparées par des
# virgules : en cas d'échec (429, 403, timeout…) le bot passe à la suivante.
#
# RPC_URL_1=https://mon-rpc-prive.example/KEY,https://ethereum-rpc.publicnode.com
# RPC_URL_8453=
# RPC_URL_43114=
# RPC_URL_43111=
# RPC_URL_14=
# RPC_URL_4663=
#
# ⚠️ Un RPC limité à des petites plages (ex. Alchemy free tier = 10 blocs)
# demande de baisser la plage de la chain : LOGS_BLOCK_RANGE_<chainId>=10
# Les anciennes variables ALCHEMY_*_RPC_URL ne sont plus lues.

# ─── Persistance des pointeurs (recommandé en production) ────────────────────
# Sans disque persistant, chaque redéploiement repart de la tête de chaîne et
# les events survenus pendant le redémarrage ne sont pas alertés.
# Sur Render : ajouter un Persistent Disk monté sur /var/data, puis :
# POINTERS_FILE=/var/data/.pointers.json

# ─── Réglages avancés (valeurs par défaut) ───────────────────────────────────
# LOGS_BLOCK_RANGE=            # force la plage eth_getLogs pour toutes les chains
# LOGS_BLOCK_RANGE_<chainId>=  # plage pour une chain (défaut : chains.js, 2000)
# LOGS_MAX_ADDRESSES=10        # adresses max par appel eth_getLogs (limite publicnode)
# RPC_MAX_RETRIES=2            # rondes de tentatives sur toutes les URLs
# MAX_CHUNKS_PER_TICK=20       # plages max par tick et par chain (borne les rattrapages)
# MAX_CHUNKS_PER_TICK_<chainId>=
# MAX_CATCHUP_BLOCKS=100000    # au boot, ne remonte jamais plus loin
# LAG_ALERT_BLOCKS=20000       # alerte Telegram si retard > N blocs (0 = off)
